# ─── Application ────────────────────────────────────────────────
# Public base URL of the app (used for auth callbacks, emails, canonical URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (PostgreSQL via docker compose) ────────────────────
POSTGRES_USER="shayvera"
POSTGRES_PASSWORD="shayvera_dev_password"
POSTGRES_DB="shayvera"
DATABASE_URL="postgresql://shayvera:shayvera_dev_password@localhost:5432/shayvera?schema=public"
# Separate database used by integration and E2E tests (created by docker/postgres/init).
DATABASE_URL_TEST="postgresql://shayvera:shayvera_dev_password@localhost:5432/shayvera_test?schema=public"
# Database used by Playwright end-to-end tests (reset and seeded on every run).
DATABASE_URL_E2E="postgresql://shayvera:shayvera_dev_password@localhost:5432/shayvera_e2e?schema=public"

# ─── Authentication (Better Auth) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Payments (Razorpay TEST mode keys from dashboard.razorpay.com) ─
# PAYMENT_GATEWAY: "razorpay" (real test/live API) or "mock" (offline simulator, dev/test only)
PAYMENT_GATEWAY="razorpay"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-me"
RAZORPAY_WEBHOOK_SECRET="replace-me"
# During webhook secret rotation, put the old secret here for ~24 h (Razorpay retries older events).
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=""
# Minutes a pending online-payment order keeps its stock reservation.
PAYMENT_EXPIRY_MINUTES="30"

# ─── Storage ─────────────────────────────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="5242880"

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL="info"

# ─── Security ────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the app (used to read the real client IP
# from X-Forwarded-For for rate limiting and audit logs).
TRUSTED_PROXY_HOPS="1"

# ─── Background jobs ─────────────────────────────────────────────
# worker: run `npm run worker` as a separate process (production default)
# inline: poll the queue inside the Next.js server (development default)
# off:    do not run jobs (tests)
# JOB_RUNNER="inline"
WORKER_POLL_MS="2000"

# ─── Shipping ────────────────────────────────────────────────────
# shiprocket (real API — no sandbox, acts on the live account), mock (offline simulator for
# development/tests) or manual (staff enter courier + AWB). Default: mock in development, manual in production.
# SHIPPING_PROVIDER="mock"
# Shiprocket API user (Shiprocket → Settings → API → Add New API User; must differ from the main login).
SHIPROCKET_API_EMAIL=""
SHIPROCKET_API_PASSWORD=""
# Security token entered in Shiprocket's webhook settings (sent as x-api-key).
SHIPROCKET_WEBHOOK_TOKEN=""
# SHIPROCKET_BASE_URL="https://apiv2.shiprocket.in/v1/external"
SHIPPING_HTTP_TIMEOUT_MS="10000"
