{
  "name": "shayvera-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "catalog:import-woo": "tsx --conditions=react-server scripts/import-woocommerce.ts",
    "catalog:import-csv": "tsx --conditions=react-server scripts/import-catalog-csv.ts",
    "email:test": "tsx --conditions=react-server scripts/email-test.ts",
    "shipping:verify": "tsx --conditions=react-server scripts/shipping-verify.ts",
    "jobs:reconcile": "tsx --conditions=react-server scripts/reconcile-payments.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "perf:check": "tsx --conditions=react-server scripts/perf-check.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "lucide-react": "1.69.0",
    "motion": "12.43.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "prisma": "6.19.3",
    "radix-ui": "1.8.1",
    "razorpay": "2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv": "18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
